_1wLAAIAAAATMjA0NjYzMzk2MTI4ODI3ODM2NAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2039423946504978712","post_id":"2039423946504978712","platform":"x","author":"AOC","original_url":"https://x.com/AOC/status/2039423946504978712","published_at":"2026-04-01T19:25:34.168Z","published_date":"2026-04-01","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"The Israeli government is well able to fund the Iron Dome system, which has proven critical to keep innocent civilians safe from rocket attacks and bombardment. \n\nConsistent with my voting record to date, I will not support Congress sending more taxpayer dollars and military aid to a government that consistently ignores international law and U.S. law. \n\nNetanyahu’s allies in the Knesset just approved a $45 billion defense budget, and the Prime Minister himself also asserted his interest in withdrawing from the MOU with the United States in January. It is fully within their ability to fund Iron Dome and other defensive systems.\n\nOur allies who need our military aid must understand that we will provide it consistent with the Leahy amendment and the foreign assistance act.","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":34264,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/AOC/with_replies?cursor=DAAHCgABHVwYZMm__1wLAAIAAAATMjA0NjYzMzk2MTI4ODI3ODM2NAgAAwAAAAIAAA","sha256":"e0a6c290546f250273dc2a205f806f266699a6e49e0e88b0ce64d3e64c36ab8a","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/AOC/with_replies?cursor=DAAHCgABHVwYZMm__1wLAAIAAAATMjA0NjYzMzk2MTI4ODI3ODM2NAgAAwAAAAIAAA","text_truncated":false}]